# ==============================================================================
# BHIMA — Earth System Intelligence Environment Configuration
# ==============================================================================

# --- Frontend (Vercel Project 1: bhima-frontend) ---
# Set to your deployed backend URL in Vercel project environment variables:
VITE_API_BASE_URL=https://your-backend-api.vercel.app

# --- Backend (Vercel Project 2: bhima-api) ---
ENVIRONMENT=production
DEBUG=false
STORAGE_BACKEND=local
BLOB_READ_WRITE_TOKEN=
CORS_ORIGINS=https://*.vercel.app,*
GEMINI_API_KEY=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
CACHE_TTL_SECONDS=3600
API_TIMEOUT_SECONDS=300
