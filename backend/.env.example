# BHIMA Backend - Vercel & Production Environment Configuration

# Application Environment
ENVIRONMENT=development
DEBUG=false
PORT=8000

# Persistent Storage Provider (local | vercel_blob | s3)
STORAGE_BACKEND=local

# Vercel Blob Object Storage
# Automatically injected by Vercel when connecting a Vercel Blob Store:
BLOB_READ_WRITE_TOKEN=

# S3 / Cloudflare R2 Storage (Alternative object storage provider)
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CORS Origins (Comma-separated or * for universal access)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app,*

# Gemini AI API Key (Optional: for Ask BHIMA assistant)
GEMINI_API_KEY=

# NASA Earthdata Credentials (Optional)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Cache Settings
CACHE_TTL_SECONDS=3600
API_TIMEOUT_SECONDS=300
